{
  "name": "mpesa-stk-masked-pin",
  "version": "1.0.0",
  "description": "Production-ready M-Pesa STK Push integration with masked PIN support — eliminates shoulder-surfing at merchant checkouts via the proposed ConfirmationMode parameter.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"vite,server\" -c \"cyan,green\" \"vite\" \"tsx watch server.ts\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "tsx server.ts",
    "server:prod": "tsx server.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SamKNato/mpesa-stk-masked-pin.git"
  },
  "keywords": [
    "mpesa",
    "safaricom",
    "daraja",
    "stk-push",
    "fintech",
    "kenya",
    "security",
    "masked-pin"
  ],
  "author": "SamKNato",
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
