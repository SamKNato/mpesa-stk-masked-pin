# ─────────────────────────────────────────────────────────────────────────────
# M-Pesa STK Push — Masked PIN Proposal
# Environment Configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Author: SamKNato — github.com/SamKNato/mpesa-stk-masked-pin
# ─────────────────────────────────────────────────────────────────────────────

# ── Daraja Credentials ────────────────────────────────────────────────────────
# Get these from: https://developer.safaricom.co.ke → My Apps → Your App

MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# ── Shortcode & Passkey ───────────────────────────────────────────────────────
# Sandbox test shortcode and passkey (safe to use in sandbox only)
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# ── Callback URL ──────────────────────────────────────────────────────────────
# Safaricom posts transaction results to this URL.
# For local dev: use ngrok → ngrok http 3001 → copy the HTTPS forwarding URL
# Example: https://a1b2c3d4.ngrok.io/api/callback
MPESA_CALLBACK_URL=https://your-ngrok-or-domain.io/api/callback

# ── Environment ───────────────────────────────────────────────────────────────
# "sandbox" for testing, "production" for live transactions
MPESA_ENVIRONMENT=sandbox

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173
